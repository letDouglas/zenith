apiVersion: external-secrets.io/v1beta1
kind: SecretStore
metadata:
  name: vault-backend
  namespace: database
spec:
  provider:
    vault:
      server: "http://VAULT_SERVER_PLACEHOLDER:30820"
      path: "secret"
      version: "v2"
      auth:
        kubernetes:
          mountPath: "kubernetes-workload"
          role: "database-role"
          serviceAccountRef:
            name: "vault-auth-sa"